# TavernShelf v0.0.2 — Environment Configuration
# Copy this to .env and fill in your values

# ── Server ────────────────────────────────────────────────
# Port to expose TavernShelf on your host machine
PORT=7624

# ── Security ──────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_generate_a_real_secret_with_openssl_rand_hex_64
JWT_EXPIRY=7d

# ── Library ───────────────────────────────────────────────
# Absolute path to your existing TTRPG folder on the host
# This folder is mounted read-write so approved uploads can be moved into it
LIBRARY_PATH=/path/to/your/ttrpg/library

# ── Admin Account (created on first run) ──────────────────
ADMIN_EMAIL=admin@tavernshelf.local
ADMIN_PASSWORD=changeme

# ── Reverse Proxy ─────────────────────────────────────────
# Set to 1 if running behind nginx, Tailscale, Cloudflare, etc.
# This enables correct IP logging and HTTPS detection via X-Forwarded-* headers
TRUST_PROXY=0

# ── Environment ───────────────────────────────────────────
NODE_ENV=production
