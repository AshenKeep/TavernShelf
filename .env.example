# TavernShelf v0.0.4 — Environment Configuration
# Copy this to .env and fill in your values

# ── Server ────────────────────────────────────────────────
PORT=7624

# ── Security ──────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_generate_a_real_secret_with_openssl_rand_hex_64
JWT_EXPIRY=7d

# ── Library ───────────────────────────────────────────────
# Absolute path to your TTRPG folder on the host (read-write)
LIBRARY_PATH=/path/to/your/ttrpg/library

# ── Admin Account (created on first run) ──────────────────
ADMIN_EMAIL=admin@tavernshelf.local
ADMIN_PASSWORD=changeme

# ── Reverse Proxy ─────────────────────────────────────────
# Set to 1 if running behind nginx, Tailscale, Cloudflare, etc.
TRUST_PROXY=0

# ── Environment ───────────────────────────────────────────
NODE_ENV=production
